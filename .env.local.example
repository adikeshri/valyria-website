# Copy to `.env.local` for local dev, and add the same two vars to the Vercel
# project (Settings → Environment Variables). Both are safe to expose in the
# client bundle — the anon key only permits INSERT on `beta_signups` (see
# supabase/schema.sql). Leave them unset and the form falls back to a mailto:.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
